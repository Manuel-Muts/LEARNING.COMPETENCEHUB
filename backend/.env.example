# PostgreSQL connection fields (BB_CONNECTION accepts pgsql/PostgreSQL).
BB_CONNECTION=pgsql
DB_HOST=YOUR_NOVAHOST_DATABASE_HOST
DB_PORT=5432
DB_DATABASE=YOUR_DATABASE_NAME
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Replace with a unique random secret before running.
AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
AUTH_SESSION_COOKIE=competencehub_session
AUTH_SESSION_TTL_HOURS=24
# Local HTTP development values. Use secure=true and samesite=none in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Admin bootstrap credentials. Set a unique password (at least 12 characters),
# then run `python -m app.seed_admin` after applying migration 004.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD

# Cloudinary document storage for admin uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=competencehub/past-papers

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set SMS_PROVIDER=talksasa to enable password-reset SMS.
SMS_PROVIDER=disabled
TALKSASA_API_KEY=
TALKSASA_SENDER_ID=
TALKSASA_BASE_URL=https://bulksms.talksasa.com

# Optional email configuration.
EMAIL_USER=
BREVO_API_KEY=

# Used only by the backend for signed-in learners' on-demand practice questions.
GEMINI_API_KEY=
